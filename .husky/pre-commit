. "$(dirname "$0")/../helpers/hook-lib.sh"
run_vendored_hook pre-commit "$@"

# Decide by what is staged. --no-renames lists both sides of a rename; -z keeps odd file names unquoted.
staged="$(git diff --cached --name-only -z --no-renames --diff-filter=ACMRD | tr '\0' '\n')"

run_tests=0
run_compile=0
while IFS= read -r path; do
  case "$path" in
    Source/HyperMug/Sources/Core/* | Source/HyperMug/Tests/* | helpers/test.sh | helpers/swift-env.sh | Makefile) run_tests=1 ;;
  esac
  case "$path" in
    Source/HyperMug/Sources/* | helpers/build.sh | helpers/compile-check.sh | helpers/swift-env.sh | Makefile | Source/HyperMug/Info.plist) run_compile=1 ;;
  esac
done <<EOS
$staged
EOS

make check-layers
if [ "$run_tests" = 1 ]; then make test; fi
if [ "$run_compile" = 1 ]; then make compile-check; fi
