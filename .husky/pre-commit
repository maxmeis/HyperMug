. "$(dirname "$0")/lib.sh"
run_vendored_hook pre-commit "$@"

# Decide by what is staged. --no-renames lists both sides of a rename; -z keeps odd file names unquoted.
staged="$(git diff --cached --name-only -z --no-renames --diff-filter=ACMRD | tr '\0' '\n')"

run_tests=0
run_compile=0
while IFS= read -r path; do
  case "$path" in
    Source/HyperMug/Sources/Core/* | Source/HyperMug/Tests/* | Source/HyperMug/scripts/test.sh) run_tests=1 ;;
  esac
  case "$path" in
    Source/HyperMug/Sources/* | Source/HyperMug/build.sh | Source/HyperMug/Info.plist | build.sh) run_compile=1 ;;
  esac
done <<EOS
$staged
EOS

./Source/HyperMug/scripts/check-layers.sh
if [ "$run_tests" = 1 ]; then ./Source/HyperMug/scripts/test.sh; fi
if [ "$run_compile" = 1 ]; then ./Source/HyperMug/scripts/compile-check.sh; fi
